{
  "name": "adam-mcp",
  "private": true,
  "version": "0.2.0",
  "description": "MCP server for University of Basel ADAM courses.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arudchayan/adam-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Arudchayan/adam-mcp/issues"
  },
  "homepage": "https://github.com/Arudchayan/adam-mcp#readme",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w adam-mcp",
    "start:browser": "npm run start -w adam-mcp -- --browser",
    "login": "npm run login -w adam-provider-browser",
    "logout": "npm run logout -w adam-provider-browser",
    "status": "npm run status -w adam-provider-browser",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w adam-mcp",
    "test:dist": "node scripts/verify-dist.mjs",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "release:check": "npm run check && npm run test:package",
    "benchmark:reads": "node --import tsx scripts/benchmark-reads.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run test:dist && npm run audit",
    "setup": "npm run build && node scripts/print-mcp-config.mjs",
    "capture:fixtures": "node scripts/capture-fixtures.mjs",
    "demo": "node docs/demo/serve.mjs",
    "demo:record": "node docs/demo/record.mjs",
    "demo:record:yc": "node docs/demo/record-yc.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "esbuild": "^0.25.9"
  }
}
